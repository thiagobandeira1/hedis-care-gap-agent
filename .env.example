# Copy to .env (never committed; CI is keyless by construction).
# Real Anthropic models are used only when CAREGAP_MODELS=anthropic AND a key is present.
CAREGAP_ANTHROPIC_API_KEY=sk-ant-...
CAREGAP_MODELS=replay            # fake | replay | anthropic
CAREGAP_VALIDATOR_MODEL=claude-sonnet-5
CAREGAP_DRAFTER_MODEL=claude-sonnet-5
CAREGAP_JUDGE_MODEL=claude-opus-5

# P6 access: embedded (in-process over data/p6.duckdb, the default) or http.
CAREGAP_P6_MODE=embedded
CAREGAP_P6_URL=http://127.0.0.1:8000
CAREGAP_P6_DB_PATH=data/p6.duckdb

CAREGAP_CLINIC_NAME=Demo Primary Care
CAREGAP_CLINIC_PHONE=555-0100
