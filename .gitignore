# ---- PHI / data hard block (portfolio-wide discipline; no patient data in this repo at all) ----
data/
notes/
outputs/
mimic/
*.csv
*.tsv
*.parquet
*.db
*.duckdb
*.sqlite
*.sqlite3
*.json.gz

# ---- Corpus & index (fetched at build; never vendored) ----
corpus/cache/
corpus/fetched/
.chroma/
chroma_db/
*.onnx
.fastembed_cache/

# ---- Secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Model / ML artifacts ----
mlruns/
models/
*.pkl
*.joblib
*.gguf

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Allow committed eval fixtures & results (curated, public-source-derived, reviewed) ----
!evals/**/*.json

# ---- Allow committed SYNTHETIC fixtures only (Synthea personas + P6 snapshots of them; never real data) ----
!synthetic/samples/**
!synthetic/p6_snapshots/**
!synthetic/**/*.json.gz
# ---- Gold-set fixtures are SYNTHETIC P6 snapshots of Synthea panel patients (committed for keyless evals) ----
!evals/gold/snapshots/**
!evals/**/*.json.gz
# Blind worksheets are regenerated from the committed snapshots: python scripts/worksheet.py --snapshots evals/gold/snapshots --out evals/gold/worksheets
evals/gold/worksheets/

# ---- Demo GIF working frames (docs/demo.gif itself is committed; regenerate with docs/make_gif.py) ----
docs/demo/
