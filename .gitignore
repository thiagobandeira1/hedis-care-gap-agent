# ---- PHI / data hard block (portfolio-wide discipline; no patient data in this repo at all) ----
data/
notes/
outputs/
mimic/
*.csv
*.tsv
*.parquet
*.db
*.duckdb
*.sqlite
*.sqlite3
*.json.gz

# ---- Corpus & index (fetched at build; never vendored) ----
corpus/cache/
corpus/fetched/
.chroma/
chroma_db/
*.onnx
.fastembed_cache/

# ---- Secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Model / ML artifacts ----
mlruns/
models/
*.pkl
*.joblib
*.gguf

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Allow committed eval fixtures & results (curated, public-source-derived, reviewed) ----
!evals/**/*.json
